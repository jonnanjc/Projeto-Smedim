# Copie este arquivo para ".env" (na mesma pasta do manage.py) e ajuste os valores.
# O arquivo .env NUNCA deve ser compartilhado publicamente nem enviado ao controle de versão.

# Ative com uma chave própria em produção (pode gerar em https://djecrety.ir/ ou similar)
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# True apenas em desenvolvimento/teste. Em produção, sempre False.
DJANGO_DEBUG=True

# Em produção, coloque o IP ou nome do servidor na rede local, separados por vírgula.
# Exemplo: DJANGO_ALLOWED_HOSTS=192.168.0.10,servidor-clinica
DJANGO_ALLOWED_HOSTS=*

# "sqlite" para teste local (não precisa configurar nada abaixo)
# "postgres" para usar PostgreSQL (produção / servidor da clínica)
DB_ENGINE=sqlite

DB_NAME=clinica_smedim
DB_USER=clinica_smedim
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Migração do sistema antigo da clínica (opcional) -----------------------
# Preencha só quando for importar pacientes/prontuário do sistema PostgreSQL
# atual da clínica (ver cadastros/management/commands/importar_pacientes_legado.py
# e prontuario/management/commands/importar_prontuario_legado.py). Antes de
# preencher, restaure o dump/backup do sistema antigo num Postgres acessível
# (pode ser local — não precisa ser o servidor de produção antigo).
# Deixe DB_LEGADO_NAME em branco para não ativar esta conexão.
DB_LEGADO_NAME=
DB_LEGADO_USER=postgres
DB_LEGADO_PASSWORD=
DB_LEGADO_HOST=localhost
DB_LEGADO_PORT=5432

# Regras de login definidas no documento da Etapa 2
MAX_TENTATIVAS_LOGIN=5
SESSAO_TIMEOUT_MINUTOS=60

# Totem de autoatendimento (Fila / Senha). O tamanho do papel vem do driver
# da impressora no PC do totem, não daqui.
FILA_TOTEM_REDIRECT_SEGUNDOS=8

# Status automático da agenda (1 = ligado, padrão): no dia, Agendado vira
# Pré-confirmado; na virada do dia, Agendado/Pré-confirmado de dias anteriores vira Faltou.
AGENDA_STATUS_AUTOMATICO=1

# Retornos grátis por profissional por dia (padrão 5). Os que passarem disso são marcados
# como encaixe sozinhos e ficam pedindo justificativa.
AGENDA_RETORNOS_POR_DIA=5

# Velocidade da voz do painel gerada no servidor (fila/voz.py): 1.0 = normal,
# maior = mais devagar. Depois de mudar: sudo systemctl restart smedim
PAINEL_VOZ_VELOCIDADE=1.4
